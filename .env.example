# Financial market data provider
ALPHA_VANTAGE_API_KEY=replace_with_your_api_key
MARKET_SYMBOLS=AAPL,MSFT,GOOGL

# Supabase PostgreSQL connection
SUPABASE_DB_HOST=replace_with_host
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=replace_with_user
SUPABASE_DB_PASSWORD=replace_with_password
SUPABASE_DB_SSLMODE=require

# Pipeline configuration
MARKETFLOW_LOG_LEVEL=INFO
MARKETFLOW_API_TIMEOUT=30
